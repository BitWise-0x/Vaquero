---
// Feature icons drawn for Vaquero: the app icon's viewfinder corners around one mark, in the accent color.
interface Props {
	name: 'private' | 'few-photos' | 'media' | 'folders' | 'decide' | 'undo' | 'chip' | 'signed';
}
const { name } = Astro.props;
const corners =
	'M3.5 8V5.5a2 2 0 0 1 2-2H8 M16 3.5h2.5a2 2 0 0 1 2 2V8 M20.5 16v2.5a2 2 0 0 1-2 2H16 M8 20.5H5.5a2 2 0 0 1-2-2V16';
const marks: Record<Props['name'], string> = {
	private: '<rect x="8.75" y="11" width="6.5" height="5.25" rx="1"/><path d="M10.25 11V9.6a1.75 1.75 0 0 1 3.5 0V11"/>',
	'few-photos': '<rect x="7.5" y="10" width="6.5" height="6" rx="1"/><path d="M10 7.75h5.5a1 1 0 0 1 1 1v5"/>',
	media: '<rect x="7" y="8" width="10" height="8" rx="1.5"/><path d="M11 10.25v3.5l2.9-1.75z" fill="currentColor"/>',
	folders: '<path d="M7 9.25a1 1 0 0 1 1-1h2.4l1.2 1.4H16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1z"/>',
	decide: '<path d="M8.5 12.25l2.3 2.3 4.7-4.85"/>',
	undo: '<path d="M9.25 10.5h4.25a2.75 2.75 0 0 1 0 5.5h-3.25"/><path d="M11 8.6l-1.9 1.9 1.9 1.9"/>',
	chip: '<rect x="9" y="9" width="6" height="6" rx="1"/><path d="M10.5 7.25v1.75M13.5 7.25v1.75M10.5 15v1.75M13.5 15v1.75M7.25 10.5H9M7.25 13.5H9M15 10.5h1.75M15 13.5h1.75"/>',
	signed: '<circle cx="12" cy="10.75" r="3"/><path d="M10.4 13.3l-.7 3.2 2.3-1.1 2.3 1.1-.7-3.2"/>',
};
---

<svg
	class="feature-icon"
	viewBox="0 0 24 24"
	width="28"
	height="28"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d={corners} />
	<Fragment set:html={marks[name]} />
</svg>
