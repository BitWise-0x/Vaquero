---
// The landing hero: a large icon with the headline to its right, then the tagline and the actions. An action whose attrs
// carry data-note shows that note in small text right below its button.

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const iconHtml = image && 'html' in image ? image.html : undefined;
---

<div class="hero">
	<div class="head">
		{iconHtml && <div class="hero-icon" set:html={iconHtml} />}
		<h1 id="_top" data-page-title set:html={title} />
	</div>
	{tagline && <p class="tagline" set:html={tagline} />}
	{
		actions.length > 0 && (
			<div class="actions">
				{actions.map(({ text, link, variant = 'primary', attrs = {} }) => {
					const { 'data-note': note, ...rest } = attrs;
					return (
						<div class="action-wrap">
							<a class:list={['action', variant]} href={link} {...rest}>
								{text}
							</a>
							{note && <span class="note">{note}</span>}
						</div>
					);
				})}
			</div>
		)
	}
</div>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-block: clamp(2rem, calc(1rem + 6vmin), 5rem) 1rem;
	}
	/* icon and headline scale together with the hero's width: three lines of text fill about the icon's height */
	.head {
		container-type: inline-size;
		display: flex;
		align-items: center;
		gap: 4cqi;
	}
	h1 {
		margin: 0;
		font-size: 8cqi;
		line-height: 1.1;
		line-height: var(--sl-line-height-headings);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.hero-icon {
		flex: none;
		width: 32cqi;
	}
	/* the icon art sits inside about 9% transparent margin; scaling it up within its box makes the visible icon a
	   little taller than the three-line headline without taking width from the text */
	.hero-icon :global(img) {
		display: block;
		width: 100%;
		height: auto;
		transform: scale(1.12);
	}
	.tagline {
		margin: 0;
		max-width: 62ch;
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		align-items: flex-start;
		gap: 0.75rem 1rem;
		margin-top: 0.25rem;
	}
	/* the button is at least as wide as its note, and the note sits centered under it */
	.action-wrap {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.35rem;
	}
	.action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0 1rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 8px;
		color: var(--sl-color-white);
		font-size: var(--sl-text-base);
		font-weight: 700;
		white-space: nowrap;
		text-decoration: none;
		transition: background-color 150ms ease, border-color 150ms ease;
	}
	.action:hover {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.action.primary {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.action.primary:hover {
		background: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent-high);
	}
	.note {
		font-size: 0.7rem;
		color: var(--sl-color-gray-2);
		text-align: center;
		white-space: nowrap;
	}
	/* phones: the two buttons share the row */
	@media (max-width: 30rem) {
		.actions {
			flex-wrap: nowrap;
			gap: 0.75rem;
		}
		.action-wrap {
			flex: none;
		}
		.note {
			font-size: 0.6rem;
		}
		.action {
			padding: 0 0.85rem;
			font-size: var(--sl-text-sm);
		}
	}
</style>
