---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { Icon } from '@astrojs/starlight/components';
---

<a class="download" href="https://github.com/BitWise-0x/Vaquero/releases/latest/download/Vaquero-arm64.dmg">
	<Icon name="download" />
	<span>Download</span>
</a>
<Default />

<style>
	.download {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.25rem;
		padding: 0 0.9rem;
		border-radius: 8px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 150ms ease;
	}
	@media (pointer: coarse) {
		.download {
			min-height: 2.75rem;
		}
	}
	.download:hover {
		background: var(--sl-color-accent-high);
		color: var(--sl-color-black);
	}
</style>
