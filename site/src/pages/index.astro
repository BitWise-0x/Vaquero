---
import { getImage, Image } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid, LinkCard, Steps } from '@astrojs/starlight/components';
import icon from '../../../assets/Vaquero.png';
import results from '../../../docs/screenshots/results.png';
import firstLaunch from '../../../docs/screenshots/first-launch.png';
import scanning from '../../../docs/screenshots/scanning.png';
import help from '../../../docs/screenshots/help.png';
import settings from '../../../docs/screenshots/settings.png';

const repo = 'https://github.com/BitWise-0x/Vaquero';
const download = `${repo}/releases/latest/download/Vaquero-arm64.dmg`;
const heroIcon = await getImage({ src: icon, width: 400 });
const shots = [
	{ src: scanning, alt: 'A scan in progress', caption: 'Scanning' },
	{ src: firstLaunch, alt: 'The face model downloading on first launch', caption: 'First launch' },
	{ src: help, alt: 'The built-in help', caption: 'Help' },
	{ src: settings, alt: 'Settings', caption: 'Settings' },
];
---

<StarlightPage
	frontmatter={{
		title: 'Vaquero',
		description:
			'Point Vaquero at a few photos of someone. It finds every photo and video of them, then copies or moves them. Free, open source, and private: it runs on your Mac.',
		hero: {
			title: 'Find and round up every photo, by face',
			tagline:
				'Point Vaquero at a few photos of someone. It finds every photo and video of them, then copies or moves them where you want. It runs on your Mac, and nothing leaves it.',
			image: {
				html: `<img src="${heroIcon.src}" width="200" height="200" alt="Vaquero icon: a buffalo inside an amber viewfinder" />`,
			},
			actions: [
				{ text: 'Download for Mac', link: download, icon: 'download', variant: 'primary' },
				{ text: 'Read the docs', link: '/docs/install/', icon: 'open-book', variant: 'secondary' },
				{ text: 'GitHub', link: repo, icon: 'github', variant: 'minimal' },
			],
		},
	}}
>
	<p class="meta">Free and open source · Apple Silicon · macOS 14 or later</p>

	<button class="zoom" type="button" data-full={results.src} data-alt="Vaquero after a scan, with the matches listed in the log" aria-label="Enlarge screenshot: matches after a scan">
		<Image src={results} alt="Vaquero after a scan, with the matches listed in the log" widths={[640, 1100, 1600]} sizes="(max-width: 1100px) 100vw, 1000px" loading="eager" />
	</button>

	<h2 id="how-it-works">How it works</h2>
	<Steps>
		<ol>
			<li><strong>Pick a few photos</strong> of the person: three to five. Group photos are fine.</li>
			<li><strong>Pick the folders</strong>: one to scan, and where the matches go.</li>
			<li><strong>Scan.</strong> Every photo and video is checked. Nothing moves yet.</li>
			<li><strong>Copy or move</strong> the matches. Every change can be undone.</li>
		</ol>
	</Steps>

	<h2 id="features">Features</h2>
	<CardGrid>
		<Card title="Private" icon="approve-check">Face detection and recognition run on your Mac. No photo, face or log leaves it.</Card>
		<Card title="No training" icon="star">A few photos of the person are enough. Photos of someone else are spotted and left out.</Card>
		<Card title="Photos and videos" icon="document">JPEG, HEIC, PNG and more. Videos are checked on evenly spaced frames.</Card>
		<Card title="Folders and shares" icon="list-format">Subfolders on request. Hidden folders and the destination are skipped.</Card>
		<Card title="You decide" icon="setting">Matches are listed first. Borderline ones are marked for review, and the threshold updates them without a rescan.</Card>
		<Card title="Undo" icon="random">Every copy and move is journaled. Keep both or overwrite when a name is taken.</Card>
		<Card title="Apple Silicon native" icon="rocket">The face models run on the Neural Engine and GPU through Core ML.</Card>
		<Card title="Signed and notarized" icon="seti:lock">Opens like any Mac app, and updates itself from inside.</Card>
	</CardGrid>

	<h2 id="what-its-for">What it's for</h2>
	<CardGrid>
		<Card title="A folder per person">Every photo of a family member, a friend or yourself, out of years of backups.</Card>
		<Card title="One person from a shared dump">An event, a trip or a group chat export.</Card>
		<Card title="Albums and slideshows">Every photo of one person, in one place.</Card>
		<Card title="Clean-up">Move someone's photos out of a mixed folder, or copy them and leave the originals.</Card>
	</CardGrid>

	<h2 id="screenshots">Screenshots</h2>
	<div class="gallery">
		{
			shots.map((s) => (
				<figure>
					<button class="zoom" type="button" data-full={s.src.src} data-alt={s.alt} aria-label={`Enlarge screenshot: ${s.caption}`}>
						<Image src={s.src} alt={s.alt} widths={[480, 760]} sizes="(max-width: 760px) 100vw, 520px" />
					</button>
					<figcaption>{s.caption}</figcaption>
				</figure>
			))
		}
	</div>

	<h2 id="docs">Docs</h2>
	<CardGrid>
		<LinkCard title="Install" description="Requirements, permissions, updates and uninstalling." href="/docs/install/" />
		<LinkCard title="Using Vaquero" description="Options, file types, scores and the log." href="/docs/using/" />
		<LinkCard title="Reference photos" description="What makes a good set, and how the person is chosen." href="/docs/reference-photos/" />
		<LinkCard title="Files" description="Logs, scan reports and the move journal." href="/docs/files/" />
		<LinkCard title="How it works" description="Detection, recognition, performance and the face model." href="/docs/how-it-works/" />
		<LinkCard title="Troubleshooting" description="Fixes for the common problems." href="/docs/troubleshooting/" />
	</CardGrid>

	<hr />
	<p class="meta">
		Free, with no account. Every version is on <a href={`${repo}/releases`}>Releases</a>. The face model is
		InsightFace's <code>buffalo_l</code>, licensed for non-commercial research use only. Vaquero is MIT licensed and
		not affiliated with InsightFace or Apple Inc. A <a href="https://bitwise0x.com">BitWise</a> product.
	</p>

	<dialog id="viewer" aria-label="Screenshot">
		<img alt="" />
	</dialog>
</StarlightPage>

<script>
	const viewer = document.getElementById('viewer') as HTMLDialogElement;
	const full = viewer.querySelector('img') as HTMLImageElement;
	document.querySelectorAll<HTMLButtonElement>('button.zoom').forEach((b) =>
		b.addEventListener('click', () => {
			full.src = b.dataset.full ?? '';
			full.alt = b.dataset.alt ?? '';
			viewer.showModal();
		}),
	);
	// any click closes: on the image or the backdrop
	viewer.addEventListener('click', () => viewer.close());
</script>

<style>
	.meta {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.zoom {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}
	.zoom :global(img) {
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
	}
	.zoom:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 4px;
		border-radius: 8px;
	}
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
	}
	figure {
		margin: 0;
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	#viewer {
		max-width: 100vw;
		max-height: 100vh;
		width: 100vw;
		height: 100vh;
		margin: 0;
		padding: 24px;
		border: 0;
		background: transparent;
		cursor: zoom-out;
	}
	#viewer[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	#viewer::backdrop {
		background: rgba(6, 8, 7, 0.92);
	}
	#viewer img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: 8px;
	}
	@media (max-width: 50rem) {
		.gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
