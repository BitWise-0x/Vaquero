---
import { Image } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid, LinkCard, Steps } from '@astrojs/starlight/components';
import FeatureIcon from '../components/FeatureIcon.astro';
import { ogImage } from '../og-image.mjs';
import scanIcon from '../../../assets/Vaquero-scan.webp';
import scanAndCopy from '../../../docs/screenshots/scan-and-copy.webp';
import firstLaunch from '../../../docs/screenshots/first-launch.webp';
import scanning from '../../../docs/screenshots/scanning.webp';
import help from '../../../docs/screenshots/help.png';
import settings from '../../../docs/screenshots/settings.png';
import menuBar from '../../../docs/screenshots/menubar.png';
import results from '../../../docs/screenshots/results.png';

const repo = 'https://github.com/BitWise-0x/Vaquero';
const download = `${repo}/releases/latest/download/Vaquero-arm64.dmg`;
const site = 'https://vaquero.bitwise0x.com/';
const description =
	'Find and Round up Photos and Videos by Face. Free, open source, no account, 100% private.';
const app = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Vaquero',
	description,
	url: site,
	image: ogImage,
	applicationCategory: 'MultimediaApplication',
	operatingSystem: 'macOS 14 or later, Apple Silicon',
	downloadUrl: download,
	softwareHelp: `${site}docs/install/`,
	license: 'https://opensource.org/licenses/MIT',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	publisher: { '@type': 'Organization', name: 'BitWise', url: 'https://bitwise0x.com', logo: 'https://bitwise0x.com/static/images/logo.png' },
};
// animated captures are served as they are: the image optimizer would keep only their first frame
const shots = [
	{ src: scanning, alt: 'A scan in progress', caption: 'Scanning', animated: true },
	{ src: firstLaunch, alt: 'The face model downloading on first launch', caption: 'First launch', animated: true },
	{ src: menuBar, alt: 'The menu bar menu during a scan: progress, time left, Cancel and Undo', caption: 'Menu bar', animated: false },
	{ src: results, alt: 'A finished scan with its matches listed', caption: 'Results', animated: false },
	{ src: help, alt: 'The built-in help', caption: 'Help', animated: false },
	{ src: settings, alt: 'Settings', caption: 'Settings', animated: false },
];
---

<StarlightPage
	frontmatter={{
		title: 'Find and Round up Photos and Videos by Face',
		tableOfContents: false,
		head: [
			{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
			{ tag: 'script', attrs: { type: 'application/ld+json' }, content: JSON.stringify(app) },
		],
		description,
		lead: 'Free, open source, no account, 100% private',
		hero: {
			title: 'Find and Round up<br>Photos&nbsp;and&nbsp;Videos<br>by&nbsp;Face',
			tagline:
				'Vaquero learns a face from a few photos, then finds every photo & video it appears in and organizes them your way. Runs entirely offline. No photo or face ever leaves your Mac.',
			image: {
				html: `<img src="${scanIcon.src}" width="240" height="240" alt="Vaquero icon: a buffalo inside an amber viewfinder" />`,
			},
			actions: [
				{ text: 'Download for Mac', link: download, variant: 'primary', attrs: { 'data-note': 'Apple Silicon · macOS 14+' } },
				{ text: 'Read the docs', link: '/docs/install/', variant: 'secondary' },
			],
		},
	}}
>
	<button class="zoom" type="button" data-full={scanAndCopy.src} data-alt="Vaquero scanning a folder, listing the matches, then copying them" aria-label="Enlarge: a scan through to a copy">
		<img src={scanAndCopy.src} width={scanAndCopy.width} height={scanAndCopy.height} alt="Vaquero scanning a folder, listing the matches, then copying them" />
	</button>

	<h2 id="how-it-works">How it works</h2>
	<Steps>
		<ol>
			<li><strong>Pick a few photos</strong> of the person: three to five. Group photos are fine.</li>
			<li><strong>Pick the folders</strong>: one to scan, and where the matches go.</li>
			<li><strong>Scan.</strong> Every photo and video is checked. Nothing moves yet.</li>
			<li><strong>Copy or move</strong> the matches. Every change can be undone.</li>
		</ol>
	</Steps>

	<h2 id="features">Features</h2>
	<div class="features not-content">
		<div class="feature"><FeatureIcon name="private" /><h3>100% private</h3><p>Face detection and recognition run on your Mac. No photo, face or log leaves it.</p></div>
		<div class="feature"><FeatureIcon name="few-photos" /><h3>No training</h3><p>A few photos of the person are enough. Photos of someone else are spotted and left out.</p></div>
		<div class="feature"><FeatureIcon name="media" /><h3>Photos and videos</h3><p>JPEG, HEIC, PNG and more. Videos are checked on evenly spaced frames.</p></div>
		<div class="feature"><FeatureIcon name="folders" /><h3>Folders and shares</h3><p>Subfolders on request. Hidden folders and the destination are skipped.</p></div>
		<div class="feature"><FeatureIcon name="decide" /><h3>You decide</h3><p>Matches are listed first. Borderline ones are marked for review, and the threshold updates them without a rescan.</p></div>
		<div class="feature"><FeatureIcon name="undo" /><h3>Undo</h3><p>Edit &gt; Undo puts the last copy or move back. Overwritten files go to the Trash where the drive has one.</p></div>
		<div class="feature"><FeatureIcon name="safe" /><h3>Safe copies</h3><p>Every file is checked before it takes its place. A full or unplugged drive never leaves a partial file.</p></div>
		<div class="feature"><FeatureIcon name="menubar" /><h3>Menu bar</h3><p>In the Dock, the menu bar, or both. Progress, Cancel and Undo without opening the window.</p></div>
		<div class="feature"><FeatureIcon name="chip" /><h3>Apple Silicon native</h3><p>The face models run on the Neural Engine and GPU through Core ML.</p></div>
		<div class="feature"><FeatureIcon name="signed" /><h3>Signed and notarized</h3><p>Opens like any Mac app. Updates are checked for Vaquero's own signature before they install.</p></div>
	</div>

	<h2 id="what-its-for">What it's for</h2>
	<CardGrid>
		<Card title="A folder per person">Every photo and video of a family member, a friend or yourself, out of years of backups.</Card>
		<Card title="One person from a shared dump">An event, a trip or a group chat export.</Card>
		<Card title="Albums and slideshows">Every photo and video of one person, in one place.</Card>
		<Card title="Clean-up">Move someone's photos out of a mixed folder, or copy them and leave the originals.</Card>
	</CardGrid>

	<h2 id="screenshots">Screenshots</h2>
	<div class="gallery">
		{
			shots.map((s) => (
				<figure>
					<button class="zoom" type="button" data-full={s.src.src} data-alt={s.alt} aria-label={`Enlarge screenshot: ${s.caption}`}>
						{s.animated ? (
							<img src={s.src.src} width={s.src.width} height={s.src.height} alt={s.alt} loading="lazy" />
						) : (
							<Image src={s.src} alt={s.alt} widths={[520, 1040]} sizes="(max-width: 760px) 100vw, 520px" quality="max" />
						)}
					</button>
					<figcaption>{s.caption}</figcaption>
				</figure>
			))
		}
	</div>

	<h2 id="docs">Docs</h2>
	<CardGrid>
		<LinkCard title="Install" description="Requirements, permissions, updates and uninstalling." href="/docs/install/" />
		<LinkCard title="Using Vaquero" description="Options, file types, scores and the log." href="/docs/using/" />
		<LinkCard title="Reference photos" description="What makes a good set, and how the person is chosen." href="/docs/reference-photos/" />
		<LinkCard title="Files" description="Logs, scan reports and the move journal." href="/docs/files/" />
		<LinkCard title="How it works" description="Detection, recognition, performance and the face model." href="/docs/how-it-works/" />
		<LinkCard title="Troubleshooting" description="Fixes for the common problems." href="/docs/troubleshooting/" />
	</CardGrid>

	<hr />
	<p class="meta">
		Free, with no account. Every version is on <a href={`${repo}/releases`}>Releases</a>. The face model is
		InsightFace's <code>buffalo_l</code>, licensed for non-commercial research use only. Vaquero is MIT licensed and
		not affiliated with InsightFace or Apple Inc. A <a href="https://bitwise0x.com">BitWise</a> product.
	</p>

	<dialog id="viewer" aria-label="Screenshot">
		<img alt="" />
	</dialog>
</StarlightPage>

<script>
	const viewer = document.getElementById('viewer') as HTMLDialogElement;
	const full = viewer.querySelector('img') as HTMLImageElement;
	document.querySelectorAll<HTMLButtonElement>('button.zoom').forEach((b) =>
		b.addEventListener('click', () => {
			full.src = b.dataset.full ?? '';
			full.alt = b.dataset.alt ?? '';
			viewer.showModal();
		}),
	);
	// any click closes: on the image or the backdrop
	viewer.addEventListener('click', () => viewer.close());
</script>

<style>
	/* the line between the hero buttons and the first screenshot */
	.meta {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.zoom {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}
	.zoom :global(img) {
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
	}
	.zoom:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 4px;
		border-radius: 8px;
	}
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
	}
	figure {
		margin: 0;
	}
	/* step numbers in the accent, inside the viewfinder corners the feature icons use */
	:global(.sl-steps > li::before) {
		color: var(--sl-color-accent);
		font-size: var(--sl-text-base);
		font-weight: 700;
		background: none;
		border-radius: 0;
		box-shadow: none;
	}
	:global(.sl-steps > li::after) {
		top: 0;
		bottom: auto;
		inset-inline-start: 0;
		width: var(--bullet-size);
		height: var(--bullet-size);
		background-color: var(--sl-color-accent);
		mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M3.5 8V5.5a2 2 0 0 1 2-2H8 M16 3.5h2.5a2 2 0 0 1 2 2V8 M20.5 16v2.5a2 2 0 0 1-2 2H16 M8 20.5H5.5a2 2 0 0 1-2-2V16'/></svg>")
			center / contain no-repeat;
	}
	/* the frame takes ::after, so the guideline between steps moves to the item's background */
	:global(.sl-steps > li) {
		background: linear-gradient(var(--sl-color-hairline-light), var(--sl-color-hairline-light)) no-repeat;
		background-size: 1px calc(100% - var(--bullet-size) - 2 * var(--bullet-margin));
		background-position: calc((var(--bullet-size) - 1px) / 2) calc(var(--bullet-size) + var(--bullet-margin));
	}
	.features {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}
	.feature {
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: var(--sl-color-gray-6);
	}
	.feature :global(.feature-icon) {
		display: block;
		width: 2rem;
		height: 2rem;
		color: var(--sl-color-accent);
	}
	/* same type as Starlight's cards in the other sections */
	.feature h3 {
		margin: 0.75rem 0 0.5rem;
		font-size: var(--sl-text-h4);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
		color: var(--sl-color-accent);
	}
	.feature p {
		margin: 0;
		font-size: var(--sl-text-body);
		color: var(--sl-color-text);
	}
	figcaption {
		margin-top: 0.5rem;
		text-align: center;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	#viewer {
		max-width: 100vw;
		max-height: 100dvh;
		width: 100vw;
		height: 100dvh;
		margin: 0;
		padding: 24px;
		border: 0;
		background: transparent;
		cursor: zoom-out;
	}
	#viewer[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	#viewer::backdrop {
		background: rgba(6, 8, 7, 0.92);
	}
	#viewer img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: 8px;
	}
	@media (max-width: 50rem) {
		.gallery,
		.features {
			grid-template-columns: 1fr;
		}
	}
</style>
